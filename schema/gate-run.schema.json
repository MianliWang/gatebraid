{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gatebraid/gate-run@1",
  "title": "Gatebraid gate-run record (gatebraid/gate-run@1)",
  "description": "Machine-readable record of one gate execution on one Slice, embedded as the fenced yaml block of the gate evidence file (templates/gate0..3-evidence.md). Every gate ends by writing its evidence file, a structured handoff comment (gatebraid/handoff@1), and updating Gate, Workflow, Last Checkpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "slice_id", "gate", "environment", "executor", "base_sha", "result", "checks"],
  "properties": {
    "schema": { "const": "gatebraid/gate-run@1" },
    "slice_id": { "type": "string", "pattern": "^P[0-9]+-S[0-9]+$" },
    "gate": { "enum": [0, 1, 2, 3] },
    "environment": { "enum": ["wsl", "windows", "macos-authority", "mixed-see-prose"] },
    "executor": {
      "enum": ["Human", "Claude Lead", "Claude Read-Only Team", "Codex Consultant", "Cowork Coordinator"]
    },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "active_branch": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "result": {
      "enum": ["passed", "stopped", "needs_approval", "blocked", "human_diagnosis_required"],
      "description": "passed → Gate field advances. stopped → e.g. dirty baseline at Gate 0 (Next Approval = Dirty Baseline Acceptance)."
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "command": { "type": "string" },
          "result": { "enum": ["pass", "fail", "skipped", "not_run"] },
          "output_ref": { "type": "string", "description": "Where the raw output lives (evidence file section, committed log path)." }
        }
      }
    },
    "repair_attempts": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "hypothesis", "result"],
        "properties": {
          "number": { "enum": [1, 2] },
          "hypothesis": { "type": "string", "minLength": 1, "description": "Must be a NEW hypothesis (ADR-0002 §4)." },
          "result": { "enum": ["green", "still_red"] },
          "consult_ref": { "type": "string", "description": "consult_id if a Codex consult occurred in sequence." }
        }
      }
    },
    "approvals": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "comment_url"],
        "properties": {
          "type": {
            "enum": [
              "Plan Approval (G1→G2)",
              "Release Approval (G2→G3)",
              "Dirty Baseline Acceptance",
              "Scope / Allowlist Change",
              "Environment Change",
              "Session Persistence",
              "Worktree Exception",
              "Human Diagnosis"
            ]
          },
          "comment_url": { "type": "string", "description": "URL of the recorded human approval comment." },
          "at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "plan_hash": { "type": "string", "description": "Gate 1+: hash of the frozen plan." },
    "allowlist_hash": { "type": "string", "description": "Gate 1+: hash of the frozen write allowlist." },
    "evidence_files": { "type": "array", "items": { "type": "string" }, "default": [] },
    "notes": { "type": "string" }
  }
}
